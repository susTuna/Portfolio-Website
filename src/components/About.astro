---
import type { MarqueeItem } from "./InfiniteMarquee.astro";
import InfiniteMarquee from "./InfiniteMarquee.astro";

const technologies: MarqueeItem[] = [
  { name: "Rust", slug: "rust" },
  { name: "Go", slug: "go" },
  { name: "C", slug: "c" },
  { name: "C++", slug: "c++" },
  { name: "C#", slug: "csharp" },
  { name: "Java", slug: "java" },
  { name: "Python", slug: "python" },
  { name: "PHP", slug: "php" },
  { name: "Flutter", slug: "flutter" },
  { name: "Kotlin", slug: "kotlin" },
  { name: "HTML5", slug: "HTML5" },
  { name: "CSS3", slug: "CSS3" },
  { name: "JavaScript", slug: "javaScript" },
  { name: "TypeScript", slug: "typeScript" },
  { name: "Tailwind CSS", slug: "tailwindcss" },
  { name: "React", slug: "react" },
  { name: "Next.js", slug: "next" },
  { name: "Node.js", slug: "nodejs" },
  { name: "Bun", slug: "bun" },
  { name: "MySQL", slug: "mysql" },
  { name: "PostgreSQL", slug: "postgre" },
  { name: "Redis", slug: "redis" },
];

const tools: MarqueeItem[] = [
  { name: "Zed", slug: "zed" },
  { name: "Docker", slug: "docker" },
  { name: "Kubernetes", slug: "kubernetes" },
  { name: "Git", slug: "git" },
  { name: "Nginx", slug: "nginx" },
  { name: "Kafka", slug: "kafka" },
  { name: "Linux", slug: "linux" },
  { name: "Bash", slug: "bash" },
  { name: "Vercel", slug: "vercel" },
  { name: "Postman", slug: "postman" },
  { name: "Azure", slug: "azure" },
  { name: "DigitalOcean", slug: "do" },
];
---

<section id="about" class="w-5/6 mx-auto m-6">
  <div class="gap-8 py-8 px-4 mx-auto">
    <div class="mt-4 md:mt-0">
      <h2
        data-aos="fade-up"
        data-aos-anchor-placement="center-bottom"
        class="mb-4 text-4xl tracking-tight font-extrabold text-primary text-transparent bg-clip-text bg-gradient-to-r from-[#d7d7d7] to-[#616161] sm:text-3xl md:text-5xl pb-2 text-center"
      >
        Get to know me!
      </h2>
      <p
        data-aos="fade-up"
        data-aos-anchor-placement="center-bottom"
        class="mb-6 font-light text-gray-500 md:text-lg text-justify dark:text-gray-400 sm:text-center  sm:w-5/6 w-full mx-auto"
      >
        I&apos;m a final year <b class="font-bold">Informatics Engineering</b>{" "}
        student at Institut Teknologi Bandung focusing on <b class="font-bold">Software and Infrastructure Engineering</b>{" "}
        I am passionate about understanding underlying systems
        to build performant applications that enchance the user experience.
        Check out some of my work in the Projects section.
        Feel free to Connect or Follow me on my{
          " "
        }
        <a
          href="https://www.linkedin.com/in/frederiko-eldad/"
          class="text-gray-400 font-medium"
        >
          Linkedin</a
        >{" "}
        <br />
        <br />
         I&apos;m open to Job opportunities where I can contribute, learn and
        grow. If you have a good opportunity that matches my skills and
        experience then don&apos;t hesitate to contact me.
      </p>
    </div>
    <section class="py-10">
      <div class="container mx-auto">
        <div data-aos="fade-up" data-aos-anchor-placement="center-bottom">
          <h1
            class="text-2xl text-transparent bg-clip-text bg-gradient-to-r from-[#d7d7d7] to-[#616161] font-extrabold py-3 text-center"
          >
            Professional Skillset
          </h1>
          <div
            class="text-white opacity-75 flex gap-8 flex-wrap w-full sm:justify-center justify-center"
          >
              <InfiniteMarquee items={technologies} speedSec={45} />
          </div>
        </div>
        <div data-aos="fade-up" data-aos-anchor-placement="center-bottom">
          <h1
            class="mt-8 text-2xl text-transparent bg-clip-text bg-gradient-to-r from-[#d7d7d7] to-[#616161] font-extrabold py-3 text-center"
          >
            Tools
          </h1>
          <div
            class="text-white opacity-75 flex gap-8 flex-wrap w-full sm:justify-center justify-center"
          >
            <InfiniteMarquee items={tools} reverse speedSec={35} />
          </div>
        </div>
      </div>
    </section>
  </div>
</section>
