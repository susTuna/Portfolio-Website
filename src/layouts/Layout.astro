---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/manrope";
import "@fontsource/poppins/100.css";
import "@fontsource/poppins/200.css";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";
import "@fontsource/poppins/900.css";

import { SEO } from "astro-seo";

const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin).toString();
const resolvedImageWithDomain = new URL(
  "/image.jpeg",
  Astro.url.origin
).toString();

interface Props {
  title: string;
}

const { title } = Astro.props;

// import { ViewTransitions } from "astro:transitions";
// import preload from "astro-preload";
import Glow from "../components/Glow";

const makeTitle = title ? title : "Frederiko Eldad Mugiyono";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Frederiko Eldad Mugiyono - Software and Infrastructure Engineer. Explore my portfolio showcasing work across backend systems, distributed infrastructure, and frontend development. Experienced with Rust, Go, Kafka, Redis, Docker, and PostgreSQL on the backend, and Next.js, React, and Tailwind CSS on the frontend. Informatics Engineering student at Institut Teknologi Bandung, with a track record building systems that scale from database to interface. Let's connect and discuss how I can contribute to your engineering team."
    />
    <meta name="author" content="Frederiko Eldad Mugiyono" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />
    <SEO
      title={makeTitle}
      description="Portfolio of Frederiko Eldad Mugiyono, a Software and Infrastructure Engineer specializing in backend systems, distributed infrastructure, and full-stack web development."
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `Frederiko Eldad Mugiyono`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Frederiko Eldad Mugiyono",
        },
        optional: {
          description: `Portfolio of Frederiko Eldad Mugiyono, a Software and Infrastructure Engineer specializing in backend systems, distributed infrastructure, and full-stack web development.`,
        },
      }}
    />
    <script
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-2M702E3SPM"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-2M702E3SPM");
    </script>

    <title>{title}</title>
  </head>
  <body>
    <Glow client:only />
    <slot />

    <style is:global>
      img {
        content-visibility: auto;
      }
      body {
        cursor: url("/cursor.png"), auto;
        font-family: "Poppins", sans-serif;
        background: #0a0a0a;
        background-size: 22px 22px;
        overflow-x: hidden;
      }
      ::-webkit-scrollbar {
        width: 10px;
      }

      ::-webkit-scrollbar-track {
        background-color: rgba(20, 20, 20);
        -webkit-border-radius: 10px;
        border-radius: 10px;
      }

      ::-webkit-scrollbar-thumb {
        -webkit-border-radius: 10px;
        border-radius: 10px;
        background: #5b5b5b;
      }
    </style>
    <script src="../utils/aos.js"></script>
  </body>
</html>
